#include <iostream>

using namespace std;

int main() {
    int numeros[10];
    int pares = 0;

    for (int i = 0; i < 10; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < 10; i++) {
        if (numeros[i] % 2 == 0) {
            pares++;
        }
    }

    cout << "Pares = " << pares << endl;

    return 0;
}
