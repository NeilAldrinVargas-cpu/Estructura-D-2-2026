#include <iostream>

using namespace std;

int main() {
    int n;
    int numeros[50]; // Tamaño máximo permitido según la condición (N <= 50)

    // 1. Leer la cantidad de elementos N
    cin >> n;

    // 2. Leer los N números enteros
    for (int i = 0; i < n; i++) {
        cin >> numeros[i];
    }

    // 3. Intercambiar el primer elemento (índice 0) con el último (índice n - 1)
    int aux = numeros[0];
    numeros[0] = numeros[n - 1];
    numeros[n - 1] = aux;

    // 4. Mostrar el arreglo modificado
    for (int i = 0; i < n; i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    return 0;
}
