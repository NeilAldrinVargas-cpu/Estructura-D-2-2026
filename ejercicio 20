#include <iostream>

using namespace std;

int main() {
    int original[6];
    int copia[6];

    // 1. Leer los 6 números enteros
    for (int i = 0; i < 6; i++) {
        cin >> original[i];
    }

    // 2. Copiar elemento por elemento al segundo arreglo
    for (int i = 0; i < 6; i++) {
        copia[i] = original[i];
    }

    // 3. Mostrar el arreglo resultante
    cout << "Copia: ";
    for (int i = 0; i < 6; i++) {
        cout << copia[i] << " ";
    }
    cout << endl;

    return 0;
}
