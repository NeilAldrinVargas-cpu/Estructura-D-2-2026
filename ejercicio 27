#include <iostream>

using namespace std;

int main() {
    int n;
    int A[50];
    int B[50];
    int productoEscalar = 0;

    // 1. Leer la cantidad de elementos N
    cin >> n;

    // 2. Leer los elementos del primer arreglo (A)
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    // 3. Leer los elementos del segundo arreglo (B)
    for (int i = 0; i < n; i++) {
        cin >> B[i];
    }

    // 4. Calcular el producto escalar acumulando A[i] * B[i]
    for (int i = 0; i < n; i++) {
        productoEscalar += A[i] * B[i];
    }

    // 5. Mostrar el resultado final
    cout << "Producto escalar = " << productoEscalar << endl;

    return 0;
}
