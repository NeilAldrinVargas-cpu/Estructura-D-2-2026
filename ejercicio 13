#include <iostream>

using namespace std;

int main() {
    int numeros[7];

    // 1. Leer los 7 números enteros
    for (int i = 0; i < 7; i++) {
        cin >> numeros[i];
    }

    // 2. Reemplazar valores negativos por 0
    for (int i = 0; i < 7; i++) {
        if (numeros[i] < 0) {
            numeros[i] = 0;
        }
    }

    // 3. Mostrar el arreglo resultante
    for (int i = 0; i < 7; i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    return 0;
}
