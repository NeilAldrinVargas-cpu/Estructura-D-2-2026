#include <iostream>

using namespace std;

int main() {
    int numeros[8];
    int positivos = 0;

    for (int i = 0; i < 8; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < 8; i++) {
        if (numeros[i] > 0) {
            positivos++;
        }
    }

    cout << "Positivos = " << positivos << endl;

    return 0;
}
