#include <iostream>

using namespace std;

int main() {
    int n;
    int original[50];
    int pares[50];
    int impares[50];
    int cantPares = 0;
    int cantImpares = 0;

    // 1. Leer la cantidad de elementos N
    cin >> n;

    // 2. Leer los N números y clasificarlos según su paridad
    for (int i = 0; i < n; i++) {
        cin >> original[i];
        
        if (original[i] % 2 == 0) {
            pares[cantPares] = original[i];
            cantPares++;
        } else {
            impares[cantImpares] = original[i];
            cantImpares++;
        }
    }

    // 3. Mostrar los arreglos resultantes
    cout << "Pares: ";
    for (int i = 0; i < cantPares; i++) {
        cout << pares[i] << " ";
    }

    cout << "; Impares: ";
    for (int i = 0; i < cantImpares; i++) {
        cout << impares[i] << " ";
    }
    cout << endl;

    return 0;
}
