#include <iostream>

using namespace std;

int main() {
    int numeros[8];
    int suma = 0;

    // 1. Leer los 8 números enteros
    for (int i = 0; i < 8; i++) {
        cin >> numeros[i];
    }

    // 2. Sumar solo los elementos en índices pares (0, 2, 4, 6)
    for (int i = 0; i < 8; i += 2) {
        suma += numeros[i];
    }

    // 3. Mostrar el resultado
    cout << "Suma índices pares = " << suma << endl;

    return 0;
}
