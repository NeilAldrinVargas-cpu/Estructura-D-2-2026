#include <iostream>

using namespace std;

int main() {
    int numeros[8];
    int negativos = 0;

    for (int i = 0; i < 8; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < 8; i++) {
        if (numeros[i] < 0) {
            negativos++;
        }
    }

    cout << "Negativos = " << negativos << endl;

    return 0;
}
