#include <iostream>

using namespace std;

int main() {
    int numeros[5];

    // 1. Leer los 5 números enteros
    for (int i = 0; i < 5; i++) {
        cin >> numeros[i];
    }

    // 2. Multiplicar cada elemento por 2
    for (int i = 0; i < 5; i++) {
        numeros[i] = numeros[i] * 2;
    }

    // 3. Mostrar el arreglo resultante
    for (int i = 0; i < 5; i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    return 0;
}
