#include <iostream>

using namespace std;

int main() {
    int n;
    int A[50];
    int B[50];
    int C[50];

    // 1. Leer la cantidad de elementos N
    cin >> n;

    // 2. Leer los elementos del primer arreglo (A)
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    // 3. Leer los elementos del segundo arreglo (B)
    for (int i = 0; i < n; i++) {
        cin >> B[i];
    }

    // 4. Calcular la suma posición por posición en el arreglo C
    for (int i = 0; i < n; i++) {
        C[i] = A[i] + B[i];
    }

    // 5. Mostrar el arreglo C resultante
    cout << "C: ";
    for (int i = 0; i < n; i++) {
        cout << C[i] << " ";
    }
    cout << endl;

    return 0;
}
