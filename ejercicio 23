#include <iostream>

using namespace std;

int main() {
    int n;
    int numeros[50]; // Tamaño máximo para cubrir el rango de N

    // 1. Leer N
    cin >> n;

    // 2. Leer los N números enteros
    for (int i = 0; i < n; i++) {
        cin >> numeros[i];
    }

    // 3. Guardar el primer elemento antes de desplazar
    int primero = numeros[0];

    // 4. Desplazar los elementos hacia la izquierda
    for (int i = 0; i < n - 1; i++) {
        numeros[i] = numeros[i + 1];
    }

    // 5. Colocar el primer elemento en la última posición (índice n - 1)
    numeros[n - 1] = primero;

    // 6. Mostrar el arreglo resultante
    for (int i = 0; i < n; i++) {
        cout << numeros[i] << " ";
    }
    cout << endl;

    return 0;
}
