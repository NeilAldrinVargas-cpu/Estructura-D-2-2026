#include <iostream>

using namespace std;

int main() {
   
    double numeros[6];
    double suma = 0.0;

    for (int i = 0; i < 6; i++) {
        cin >> numeros[i];
        suma += numeros[i];
    }

    double promedio = suma / 6.0;

    cout << "Promedio = " << promedio << endl;

    return 0;
}
