#include <iostream>

using namespace std;

int main() {
    int numeros[10];
    int ceros = 0;

    // 1. Leer los 10 números enteros
    for (int i = 0; i < 10; i++) {
        cin >> numeros[i];
    }

    // 2. Contar cuántos números son exactamente cero
    for (int i = 0; i < 10; i++) {
        if (numeros[i] == 0) {
            ceros++;
        }
    }

    // 3. Mostrar el resultado final
    cout << "Ceros = " << ceros << endl;

    return 0;
}
